#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC -1
#endif

IDR_LAB6_MENU MENU
BEGIN
    POPUP "Файл"
    BEGIN
        MENUITEM "Вихід",                       IDM_FILE_EXIT
    END
    POPUP "Робота"
    BEGIN
        MENUITEM "Ввести параметри...",         IDM_WORK_PARAMS
    END
END

IDD_PARAMS_DIALOG DIALOGEX 0, 0, 210, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Параметри вектора (Варіант 3)"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Кількість елементів (n):", IDC_STATIC, 12, 14, 95, 10
    EDITTEXT        IDC_EDIT_N, 118, 12, 78, 14, ES_AUTOHSCROLL

    LTEXT           "Мінімум (Min):", IDC_STATIC, 12, 36, 95, 10
    EDITTEXT        IDC_EDIT_MIN, 118, 34, 78, 14, ES_AUTOHSCROLL

    LTEXT           "Максимум (Max):", IDC_STATIC, 12, 58, 95, 10
    EDITTEXT        IDC_EDIT_MAX, 118, 56, 78, 14, ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Виконати", IDOK, 44, 88, 56, 16
    PUSHBUTTON      "Скасувати", IDCANCEL, 110, 88, 56, 16
END